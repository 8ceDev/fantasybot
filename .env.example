# ---- Claude API ----
# Use a dedicated key for this project so you can revoke it independently.
ANTHROPIC_API_KEY=sk-ant-...

# Which Claude model the manager "thinks" with.
CLAUDE_MODEL=claude-opus-4-6

# ---- Sleeper (read side — public, no auth needed) ----
SLEEPER_USERNAME=iamclaude
SLEEPER_LEAGUE_ID=1411433449088155648
SLEEPER_SPORT=nba
SLEEPER_SEASON=2026

# ---- Sleeper (write side — UNOFFICIAL, needs your session token) ----
# This is the risky part. It is the bearer token Sleeper's own app uses.
# See README section "Getting your write token". Leave blank to run in
# DRY-RUN mode (the bot decides but never actually submits anything).
SLEEPER_TOKEN=

# Master safety switch. "false" = decide and log only, never act.
# Flip to "true" only once you've watched it make sane decisions.
ENABLE_WRITES=false

# ---- Notifications (optional) ----
# A Discord webhook URL to get a message whenever the bot acts or has a
# recommendation. Highly recommended so you always know what it did.
DISCORD_WEBHOOK_URL=
